}

float media3(float a, float b, float c)
{
    return (a + b + c) / 3.0f;
}

double media2(double a, double b)
{
    return (a + b) / 2.0;
}

bool eh_par(int x)
{
    return x % 2 == 0;
}

void mostrar_resultados(int x, int y)
{
