TEST(ParserTest, ArquivoAbrangente) {

    // Abre o arquivo físico para o Flex ler

    FILE* fp = fopen("tests/parser/teste_parser.cmm", "r");

    ASSERT_NE(fp, nullptr) << "Não foi possível abrir o arquivo de teste!";

    

    // Aponta o Lexer para esse arquivo

    extern FILE* yyin;

    yyin = fp;


    extern int line;

    line = 1;



    // Executa o parser

    int result = yyparse();

    

    fclose(fp);

    

    // O resultado deve ser 0 (sucesso sintático)

    EXPECT_EQ(result, 0);

}