{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Compilar e Executar",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debug/compilador",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/debug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: compilar debug",
            "presentation": {
                "focus": true
            }
        }
    ]
}
