{
    "files.exclude": {
        ".github": true,
        "docs": true,
        "tests": false,
        ".editorconfig": true,
        ".gitignore": true,
        "mkdocs.*": true,
        "poetry.*": true,
        "pyproject.*": true,
        "README.*": true
    },
    "files.associations": {
        "*.cmm": "plaintext"
    },
    "cSpell.words": [
        "ascii",
        "atof",
        "atoi",
        "Booleanos",
        "charval",
        "cminus",
        "DIVEQ",
        "doubleval",
        "floatval",
        "fprintf",
        "insts",
        "intval",
        "JUMPF",
        "Linka",
        "linkar",
        "LPAREN",
        "MINUSEQ",
        "MODEQ",
        "MULT",
        "MULTEQ",
        "noyywrap",
        "nullptr",
        "PLUSEQ",
        "RPAREN",
        "stdlib",
        "strdup",
        "STREQUAL",
        "strtod",
        "strtof",
        "strval",
        "symtable",
        "yyerror",
        "yyin",
        "yylex",
        "yylineno",
        "yylval",
        "yyparse",
        "yytext",
        "yywrap"
    ]
}
